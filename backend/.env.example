DATABASE_URL=postgresql+psycopg://postgres:[YOUR-PASSWORD]@[YOUR-SUPABASE-HOST]:5432/postgres?sslmode=require
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_TEMPERATURE=0.1
OLLAMA_NUM_PREDICT=2048
AGENT_MAX_ITERATIONS=3
AGENT_MAX_TOOL_CALLS=3
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cpu
MAX_UPLOAD_SIZE_MB=25
ENVIRONMENT=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:5173
CHUNK_SIZE=500
CHUNK_OVERLAP=100
MIN_CHUNK_SIZE=100
RETRIEVAL_TOP_K_DEFAULT=5
RETRIEVAL_TOP_K_MAX=20
MAX_QUERY_LENGTH=8000
RAG_CONTEXT_MAX_CHARS=8000
RAG_MIN_SIMILARITY=0.30
ENABLE_METRICS_ENDPOINT=true
ENABLE_REQUEST_LOGGING=true
EVAL_GOLDEN_SET_DIR=../eval/golden_sets
EVAL_REPORT_DIR=../eval/reports
